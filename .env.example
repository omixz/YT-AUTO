# =============================================================================
# Peakcut / ClipAI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control!
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=production                    # production | development
DEBUG=false                               # Set to true only for local debugging
SITE_URL=https://your-domain.com          # Your public HTTPS URL (required for OAuth, Stripe)
CONTACT_EMAIL=support@your-domain.com     # Contact email for privacy/terms pages

# ─── Security ────────────────────────────────────────────────────────────────
SESSION_SECRET_KEY=                       # Generate with: openssl rand -hex 32 (64+ chars recommended)
COOKIE_SECURE=true                        # Must be true in production (HTTPS only)

# ─── Stripe Billing ──────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...             # Secret API key (sk_live_... for production)
STRIPE_PRICE_ID=price_...                 # Pro tier price ID (recurring monthly)
STRIPE_PRICE_ID_PLUS=price_...            # Pro Plus tier price ID
STRIPE_WEBHOOK_SECRET=whsec_...           # Webhook signing secret (from Stripe Dashboard > Webhooks)

# ─── Google OAuth (Sign in with Google) ──────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.com/auth/google/callback
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Sign up at: https://resend.com (3,000 emails/month free)
RESEND_API_KEY=re_...
EMAIL_FROM=Peakcut <clips@your-domain.com>  # Must use verified domain in Resend

# ─── AdSense ─────────────────────────────────────────────────────────────────
# Get from: https://adsense.google.com (after site approval)
ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX

# ─── Processing Limits ───────────────────────────────────────────────────────
FREE_LIMIT=5                              # Free videos per month per user
MAX_UPLOAD_MB=300                         # Max upload size in MB
WHISPER_MODEL=tiny                        # tiny | base | small | medium | large-v3

# ─── Spend Caps (Monthly) ────────────────────────────────────────────────────
# Set to 0 to disable cap
WHISPER_MAX_MINUTES_PER_MONTH=10000       # Max Whisper transcription minutes
GOOGLE_TRANSLATE_MAX_CHARS_PER_MONTH=5000000  # Max translation characters
PIPER_TTS_MAX_CHARS_PER_MONTH=1000000     # Max TTS characters
STRIPE_MAX_WEBHOOKS_PER_HOUR=100          # Max webhook events per hour

# ─── Resource Management ─────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=1                     # 1 for 512MB, 2+ for 2GB+ RAM
MAX_QUEUE_SIZE=10                         # Max queued jobs before 503
JOB_MAX_AGE_HOURS=24                      # Auto-cleanup old jobs
ENABLE_LOCAL_FALLBACK=false               # Enable local hardware processing
LOCAL_WORKER_URL=http://localhost:8001    # Local worker endpoint
LOCAL_WORKER_API_KEY=                     # API key for local worker auth

# ─── Optional: Redis (for distributed rate limiting / queue) ─────────────────
REDIS_URL=                                # redis://user:pass@host:port/db

# ─── Optional: S3-compatible storage (for large file handling) ───────────────
S3_ENDPOINT_URL=                          # e.g. https://s3.us-east-1.amazonaws.com
S3_BUCKET=                                # Bucket name
S3_ACCESS_KEY=                            # Access key ID
S3_SECRET_KEY=                            # Secret access key
S3_REGION=us-east-1

# ─── Monitoring ──────────────────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL_SECONDS=30          # Health check frequency
METRICS_ENABLED=true                      # Enable /metrics endpoint
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR