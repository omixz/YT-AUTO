# Copy to .env and fill in. Never commit the real .env.

# Google Gemini (script writing + topic brainstorming) - free tier.
# Get one at https://aistudio.google.com/apikey (no billing required).
GEMINI_API_KEY=your-gemini-api-key

# Pexels (free stock video/photo search) - https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key

# YouTube Data API v3 OAuth client
# 1. Create a project + OAuth client (Desktop app type) in Google Cloud Console.
# 2. Enable the "YouTube Data API v3".
# 3. Download the client secret JSON and point to it here.
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
# Created automatically on first run after you complete the OAuth consent flow.
YOUTUBE_TOKEN_FILE=token.json
